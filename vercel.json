{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/work", "destination": "/credits", "permanent": true },
    { "source": "/work.html", "destination": "/credits", "permanent": true },
    { "source": "/about", "destination": "/bio", "permanent": true },
    { "source": "/about.html", "destination": "/bio", "permanent": true },
    { "source": "/contact", "destination": "/bio", "permanent": true },
    { "source": "/contact.html", "destination": "/bio", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|woff2|mp4)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
